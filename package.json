{
  "name": "dsrt-ai-website",
  "version": "1.0.0",
  "private": true,
  "description": "DSRT AI website migrated to TypeScript with a Node.js workflow; original design preserved.",
  "scripts": {
    "dev": "concurrently -k \"npm:watch:ts\" \"npm:serve\"",
    "serve": "vite --host 0.0.0.0",
    "watch:ts": "tsc --watch --preserveWatchOutput",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch src/server/server.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "resend": "^6.38.1"
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": false,
    "skipLibCheck": true,
    "noCheck": true,
    "outDir": "public/compiled",
    "rootDir": "src/legacy",
    "removeComments": false,
    "sourceMap": true
  },
  "include": [
    "src/legacy/**/*.ts"
  ]
}